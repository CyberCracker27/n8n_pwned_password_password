      "id": "8ebf5443-21f8-43d2-b72e-1cc421d5e29a",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "\nconst cryptoData = $('Code in JavaScript').item.json;\nconst suffix = String(cryptoData.suffix).toUpperCase();\n\n// The HTTP Request node's response should be text.\n// Check its output and adjust this mapping if needed.\nconst response = String($json.data ?? $json.body ?? '');\n\nif (!response.includes(':')) {\n  throw new Error('HIBP response missing or incorrectly mapped');\n}\n\nlet count = 0;\n\nfor (const line of response.split(/\\r?\\n/)) {\n  const [returnedSuffix, rawCount] = line.trim().split(':');\n\n  if (\n    returnedSuffix?.toUpperCase() === suffix &&\n    Number(rawCount) > 0\n  ) {\n    count = Number(rawCount);\n    break;\n  }\n}\n\nreturn {\n  json: {\n    tag: 'NGP-013',\n    verdict: count > 0 ? 'FOUND' : 'NOT_FOUND',\n    severity: count > 0 ? 'HIGH' : 'INFO',\n    occurrence_count: count\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "id": "c2099d83-8f22-4b94-9409-14095a87b7ab",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tag: {{$json.tag}}\nVerdict: {{$json.verdict}}\nSeverity: {{$json.severity}}\nOccurrence count: {{$json.occurrence_count}}\nGuidance type: {{$json.guidance_type}}\n\nYou are the NGP-013 password security guidance assistant.\n\nUse only the supplied verdict and severity. Never ask for or reconstruct the original password or hash.\n\nIf verdict is FOUND, explain that the password appears in a known compromised-password dataset. Recommend changing it anywhere it is used, choosing a unique password, and enabling MFA.\n\nIf verdict is NOT_FOUND, explain that no match was found in the checked dataset, but this does not guarantee security.\n\nIf the check failed, recommend retrying it.\n\nGive no more than two short sentences. Never claim that a password is completely safe.",
