    {
      "parameters": {
        "jsCode": "\nconst hash = String($input.first().json.sha1 ?? \"\").toUpperCase();\n\nif (!/^[0-9A-F]{40}$/.test(hash)) {\n  throw new Error(\"Invalid SHA-1 hash. Check Crypto output encoding.\");\n}\n\nreturn {\n  json: {\n    prefix: hash.slice(0, 5),\n    suffix: hash.slice(5),\n  }\n};\n"
      },
